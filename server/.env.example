# Copy to server/.env (gitignored) and fill in.
ANTHROPIC_API_KEY=sk-ant-...

# Optional (defaults shown)
# AIGM_MODEL=claude-sonnet-5-5
# AIGM_MAX_TOKENS=16000
# AIGM_THINKING_SUMMARIES=true   # false for models without adaptive thinking
# AIGM_EFFORT=medium              # low | medium | high | xhigh | max (default: medium; empty: the model's own)
# AIGM_STREAM_THINKING=true
# AIGM_ROLL_PAUSE=0.8
# AIGM_DEBUG=false              # true: expose GET /debug/context (shows the GM's secrets; same as `aigm --debug`)
# AIGM_PROMPT_DIR=./my-prompts  # override/extend packaged prompt files
# History the model sees (docs/HISTORY.md). Stored messages are never changed; these only shape what is sent.
# AIGM_HISTORY_TRIM=true         # old turns lose thinking blocks and tool calls become one-line notes
# AIGM_HISTORY_TRIM_KEEP=4       # the newest turns never trimmed
# AIGM_HISTORY_TRIM_STEP=6       # the trim cut moves this many turns at a time (keeps the prompt cache warm)
# AIGM_HISTORY_DIGEST=true       # old turns are replaced by short digests written by the world curator
# AIGM_HISTORY_DIGEST_KEEP=12    # the newest turns always shown in full
# AIGM_HISTORY_DIGEST_STEP=12
# AIGM_METRICS=true              # one JSON line per turn in {AIGM_SAVE_DIR}/metrics/{session}.jsonl

# Local models: run the GM and the world curator on Ollama instead of Anthropic (no API key needed)
# AIGM_PROVIDER=ollama
# AIGM_MODEL=gemma4:12b          # an Ollama tag that supports tools
# AIGM_OLLAMA_HOST=http://localhost:11434
# AIGM_OLLAMA_NUM_CTX=32768      # context per call; Ollama's own default would cut the prompt
# AIGM_OLLAMA_KEEP_ALIVE=1h      # how long the model stays loaded
# AIGM_OLLAMA_THINK=             # true/false to ask for or forbid thinking; empty: the model's own
# AIGM_WORLD_MODEL=              # curator models default to AIGM_MODEL on Ollama
